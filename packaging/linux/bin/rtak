#!/usr/bin/env bash
# rtak - manage the RTAK Server. One command instead of remembering systemd.
# Deliberately depends on nothing but the bundle itself (no curl / ss / hostname).
set -uo pipefail

PREFIX=/opt/rtak
ENV_FILE=/etc/rtak/rtak.env
CERT_DIR=/etc/rtak/certs
DATA_DIR=/var/lib/rtak
UTIL="$PREFIX/bin/rtak-util"
SSL="$PREFIX/bin/openssl"
PY="$PREFIX/runtime/python/bin/python3"
SERVICES=(rtak-takcore rtak-mediamtx)

c_g=$'\033[1;32m'; c_r=$'\033[1;31m'; c_y=$'\033[1;33m'; c_b=$'\033[1;36m'; c_0=$'\033[0m'
FAILED=0
ok()   { printf "  ${c_g}OK${c_0}    %s\n" "$*"; }
bad()  { printf "  ${c_r}FAIL${c_0}  %s\n" "$*"; FAILED=$((FAILED+1)); }
warn() { printf "  ${c_y}WARN${c_0}  %s\n" "$*"; }
head_(){ printf "\n${c_b}%s${c_0}\n" "$*"; }
need_root(){ [ "$(id -u)" -eq 0 ] || { echo "This command needs sudo:  sudo rtak $CMD"; exit 1; }; }
load_env(){ if [ -f "$ENV_FILE" ]; then set -a; . "$ENV_FILE"; set +a; fi; }
caddy_enabled(){ systemctl is-enabled rtak-caddy >/dev/null 2>&1; }
# Ports come from rtak.env so a machine where 8080 (or 80) is already taken by
# another program still works - load_env exports them, subshells included.
web_port(){ echo "${HTTP_PORT:-8080}"; }
caddy_http_port(){ echo "${CADDY_HTTP_PORT:-80}"; }
caddy_https_port(){ echo "${CADDY_HTTPS_PORT:-443}"; }
all_services(){ local s=("${SERVICES[@]}"); caddy_enabled && s+=(rtak-caddy); printf '%s\n' "${s[@]}"; }

usage(){ cat <<USAGE
rtak - RTAK Server control

  rtak status              show service + port status
  rtak start|stop|restart  control all RTAK services
  rtak logs [-f] [svc]     view logs (svc: takcore|mediamtx|caddy)
  rtak doctor              full self-test - run this before asking for help
  rtak backup [file]       back up database, certificates and settings
  rtak restore <file>      restore from a backup
  rtak enroll [callsign]   create a device enrollment token
  rtak url                 print the address to open in a browser
  rtak config              show current settings (secrets hidden)
  rtak version             show version
  rtak uninstall           remove RTAK Server (asks about keeping data)
USAGE
}

cmd_status(){
  load_env
  head_ "Services"
  for s in $(all_services); do
    if systemctl is-active --quiet "$s"; then printf "  ${c_g}running${c_0}  %s\n" "$s"
    else printf "  ${c_r}stopped${c_0}  %s\n" "$s"; fi
  done
  head_ "Listening ports"
  local ports="$(web_port) 8089 8446 8554 1935 8889 9996"
  caddy_enabled && ports="$ports $(caddy_http_port) $(caddy_https_port)"
  for p in $ports; do
    if "$UTIL" portopen "$p"; then printf "  ${c_g}open${c_0}    %-5s %s\n" "$p" "$(port_label "$p")"
    else printf "  ${c_y}closed${c_0}  %-5s %s\n" "$p" "$(port_label "$p")"; fi
  done
  cmd_url
}

port_label(){
  [ "$1" = "$(web_port)" ] && { echo "web UI / API"; return; }
  [ "$1" = "$(caddy_http_port)" ] && { echo "HTTP redirect / Let's Encrypt"; return; }
  [ "$1" = "$(caddy_https_port)" ] && { echo "HTTPS"; return; }
  case "$1" in
  8089) echo "device CoT over TLS";; 8446) echo "device enrollment";;
  8554) echo "RTSP video";; 1935) echo "RTMP video";; 8889) echo "WebRTC video";;
  9996) echo "recording playback";; *) echo "";; esac; }

cmd_url(){
  load_env
  head_ "Open in a browser"
  if caddy_enabled && [ -n "${TAK_DOMAIN:-}" ] && [ "${TAK_DOMAIN}" != "localhost" ]; then
    echo "  https://${TAK_DOMAIN}"
  fi
  echo "  http://$("$UTIL" localip 2>/dev/null || echo localhost):$(web_port)"
}

cmd_logs(){
  local follow=() svc=()
  for a in "$@"; do case "$a" in
    -f|--follow) follow=(-f);; takcore|mediamtx|caddy) svc=(-u "rtak-$a");; esac; done
  if [ ${#svc[@]} -eq 0 ]; then for s in $(all_services); do svc+=(-u "$s"); done; fi
  journalctl "${svc[@]}" -n 200 --no-pager "${follow[@]}"
}

cmd_doctor(){
  FAILED=0; load_env
  head_ "Services"
  for s in $(all_services); do
    if systemctl is-active --quiet "$s"; then ok "$s is running"
    else bad "$s is NOT running   (see: rtak logs ${s#rtak-})"; fi
  done

  head_ "Network ports"
  local ports="$(web_port) 8089 8446 8554 8889"
  caddy_enabled && ports="$ports $(caddy_http_port) $(caddy_https_port)"
  for p in $ports; do
    if "$UTIL" portopen "$p"; then ok "port $p listening  ($(port_label "$p"))"
    else bad "port $p NOT listening  ($(port_label "$p"))"; fi
  done

  head_ "Web + video APIs"
  local code; code=$("$UTIL" httpcode "http://127.0.0.1:$(web_port)/api/config" 2>/dev/null)
  case "$code" in 200|401|403) ok "web API responding (HTTP $code)";;
    *) bad "web API not responding (got '${code:-none}')";; esac
  code=$("$UTIL" httpcode http://127.0.0.1:9997/v3/paths/list 2>/dev/null)
  [ "$code" = "200" ] && ok "video engine API responding" || bad "video engine API not responding"

  head_ "Certificates"
  if [ -f "$CERT_DIR/server.pem" ]; then
    local end days=""; end=$("$SSL" x509 -in "$CERT_DIR/server.pem" -noout -enddate 2>/dev/null | cut -d= -f2)
    if [ -n "$end" ]; then
      local e n; e=$(date -d "$end" +%s 2>/dev/null || echo ""); n=$(date +%s)
      [ -n "$e" ] && days=$(( (e - n) / 86400 ))
    fi
    if [ -n "$days" ] && [ "$days" -lt 0 ]; then bad "server certificate EXPIRED ($end)"
    elif [ -n "$days" ] && [ "$days" -lt 30 ]; then warn "server certificate expires in $days days - run: sudo rtak renew-certs"
    else ok "server certificate valid${days:+ ($days days left)}"; fi
    local sans; sans=$("$SSL" x509 -in "$CERT_DIR/server.pem" -noout -ext subjectAltName 2>/dev/null | tail -1 | sed 's/^[[:space:]]*//')
    [ -n "$sans" ] && echo "        covers: $sans"
    if [ -n "${SERVER_HOST:-}" ] && [ -n "$sans" ] && ! echo "$sans" | grep -q "$SERVER_HOST"; then
      bad "certificate does NOT cover SERVER_HOST=$SERVER_HOST - devices will refuse to connect"
    fi
  else bad "no server certificate at $CERT_DIR/server.pem"; fi
  [ -f "$CERT_DIR/ca.pem" ] && ok "certificate authority present" || bad "CA missing ($CERT_DIR/ca.pem)"

  head_ "Database"
  if [ -f "$DATA_DIR/takcore.db" ]; then
    local r; r=$("$UTIL" dbcheck "$DATA_DIR/takcore.db" 2>/dev/null)
    [ "$r" = "ok" ] && ok "database integrity ok" || bad "database integrity: ${r:-unreadable}"
    echo "        devices enrolled: $("$UTIL" dbcount "$DATA_DIR/takcore.db" 2>/dev/null)"
  else warn "database not created yet (normal before the first device connects)"; fi

  head_ "Disk"
  local avail pct
  avail=$(df -h "$DATA_DIR" 2>/dev/null | awk 'NR==2{print $4}')
  pct=$(df "$DATA_DIR" 2>/dev/null | awk 'NR==2{gsub("%","",$5);print $5}')
  if [ -n "$pct" ] && [ "$pct" -gt 90 ]; then bad "disk ${pct}% full (${avail} left) - a full disk breaks the database"
  else ok "disk space ${avail:-unknown} free"; fi

  head_ "Bundled tools"
  "$SSL" version >/dev/null 2>&1 && ok "openssl works ($("$SSL" version 2>/dev/null))" || bad "openssl not working"
  "$PY" -V >/dev/null 2>&1 && ok "python works ($("$PY" -V 2>&1))" || bad "python not working"

  echo
  if [ "$FAILED" -eq 0 ]; then printf "${c_g}All checks passed - the server is healthy.${c_0}\n"
  else printf "${c_r}%s check(s) failed.${c_0}  Try:  rtak logs\n" "$FAILED"; return 1; fi
}

cmd_backup(){
  need_root
  local out="${1:-/var/backups/rtak-$(date +%Y%m%d-%H%M%S).tar.gz}"
  mkdir -p "$(dirname "$out")"
  tar czf "$out" -C / etc/rtak var/lib/rtak/takcore.db 2>/dev/null
  echo "Backup written: $out"
  echo "  includes: settings, CA + certificates, device database"
  echo "  excludes: recordings (large) - they stay in $DATA_DIR/recordings"
}

cmd_restore(){
  need_root
  local f="${1:-}"; [ -f "$f" ] || { echo "usage: sudo rtak restore <backup.tar.gz>"; exit 1; }
  echo "This replaces current settings, certificates and the device database."
  printf "Type 'yes' to continue: "; read -r a; [ "$a" = yes ] || { echo "Aborted."; exit 1; }
  systemctl stop rtak-takcore rtak-mediamtx rtak-caddy 2>/dev/null
  tar xzf "$f" -C /
  chown -R rtak:rtak /var/lib/rtak /etc/rtak/certs 2>/dev/null
  systemctl start rtak-takcore rtak-mediamtx 2>/dev/null
  caddy_enabled && systemctl start rtak-caddy 2>/dev/null
  echo "Restored. Check with: rtak doctor"
}

cmd_enroll(){
  load_env
  local callsign="${1:-device-$(date +%H%M%S)}"
  rm -f /tmp/.rtak-cookies
  "$UTIL" postjson "http://127.0.0.1:$(web_port)/api/login" \
     "{\"username\":\"${ADMIN_USER:-admin}\",\"password\":\"${ADMIN_PASSWORD:-}\"}" >/dev/null 2>&1 \
     || { echo "Could not log in to the local API. Is it running?  rtak status"; exit 1; }
  "$UTIL" postjson "http://127.0.0.1:$(web_port)/api/enroll/tokens" "{\"callsign\":\"$callsign\"}" | "$PY" -c '
import json,sys
raw=sys.stdin.read()
try: d=json.loads(raw)
except Exception: print("Unexpected reply:", raw[:200]); sys.exit(1)
if "error" in d: print("Error:", d["error"]); sys.exit(1)
print("Enrollment token created for callsign:", '"\"$callsign\""')
print("  username :", d.get("username"))
print("  token    :", d.get("token"))
print()
print("On the phone: open the RTAK web UI -> Enroll device -> scan the QR code.")'
  rm -f /tmp/.rtak-cookies
}

cmd_config(){
  load_env
  head_ "Settings ($ENV_FILE)"
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue;; esac
    local k="${line%%=*}" v="${line#*=}"
    case "$k" in *PASSWORD*|*TOKEN*|*SECRET*) v="********";; esac
    printf "  %-22s %s\n" "$k" "$v"
  done < "$ENV_FILE"
  printf "\n  Edit:  sudo nano %s   then:  sudo rtak restart\n" "$ENV_FILE"
}

cmd_renew_certs(){
  need_root; load_env
  echo "Re-issuing the server certificate for: ${SERVER_HOST:-localhost} $("$UTIL" localip)"
  CERTS_DIR="$CERT_DIR" PATH="$PREFIX/bin:$PATH" "$PREFIX/scripts/make-certs.sh" "${SERVER_HOST:-localhost}" "$("$UTIL" localip)"
  chown -R rtak:rtak "$CERT_DIR"; systemctl restart rtak-takcore
  echo "Done. Existing devices keep working (same CA)."
}

CMD="${1:-}"; shift 2>/dev/null || true
case "$CMD" in
  status)      cmd_status ;;
  start)       need_root; systemctl start $(all_services); cmd_status ;;
  stop)        need_root; systemctl stop $(all_services) ;;
  restart)     need_root; systemctl restart $(all_services); cmd_status ;;
  logs)        cmd_logs "$@" ;;
  doctor)      cmd_doctor ;;
  backup)      cmd_backup "$@" ;;
  restore)     cmd_restore "$@" ;;
  enroll)      cmd_enroll "$@" ;;
  url)         cmd_url ;;
  config)      cmd_config ;;
  renew-certs) cmd_renew_certs ;;
  version)     echo "RTAK Server $(cat "$PREFIX/VERSION" 2>/dev/null || echo unknown)" ;;
  uninstall)   need_root; exec "$PREFIX/uninstall.sh" "$@" ;;
  ""|-h|--help|help) usage ;;
  *) echo "Unknown command: $CMD"; echo; usage; exit 1 ;;
esac
