[Unit]
Description=RTAK Server - Caddy HTTPS front door (Let's Encrypt)
After=network-online.target rtak-takcore.service
Wants=network-online.target
PartOf=rtak.target

[Service]
Type=notify
User=rtak
Group=rtak
EnvironmentFile=/etc/rtak/rtak.env
# Caddy stores its certificates and internal CA under $XDG_DATA_HOME. Pin it
# inside the one writable path below, otherwise it tries $HOME/.local and dies
# on ProtectSystem=strict with a read-only filesystem error.
Environment=XDG_DATA_HOME=/var/lib/rtak/caddy
Environment=XDG_CONFIG_HOME=/var/lib/rtak/caddy
ExecStart=/opt/rtak/bin/caddy run --config /opt/rtak/config/Caddyfile --adapter caddyfile
ExecReload=/opt/rtak/bin/caddy reload --config /opt/rtak/config/Caddyfile --adapter caddyfile --force
Restart=always
RestartSec=5

# binding 80/443 as a non-root user needs exactly this one capability
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rtak/caddy
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
