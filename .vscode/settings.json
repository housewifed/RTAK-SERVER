{
  // takcore lives in app/, so tell the Python tools where to resolve imports.
  "python.analysis.extraPaths": ["app"],
  "python.autoComplete.extraPaths": ["app"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  // Build output and caches are noise in the explorer / search.
  "files.exclude": {
    "**/__pycache__": true,
    "**/.DS_Store": true,
    "dist": true,
    "packaging/build/.cache": true,
    "packaging/build/.stage-*": true
  },
  "search.exclude": {
    "dist": true,
    "packaging/build/.cache": true
  },

  // systemd units and the env template are not recognised by default.
  "files.associations": {
    "*.service": "ini",
    "*.target": "ini",
    "rtak.env": "properties",
    "Caddyfile": "plaintext",
    "rtak": "shellscript",
    "rtak-util": "python"
  },

  "[shellscript]": { "editor.tabSize": 2 },
  "[python]": { "editor.rulers": [79] },
  "shellcheck.enable": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
